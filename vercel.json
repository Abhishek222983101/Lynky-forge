{
  "version": 2,
  "builds": [
    {
      "src": "apps/api/api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["apps/api/dist/**", "apps/api/node_modules/**", "apps/api/prisma/**"]
      }
    },
    {
      "src": "apps/web/next.config.js",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/apps/api/api/index.ts" },
    { "src": "/(.*)", "dest": "/apps/web/$1" }
  ]
}
