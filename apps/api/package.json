{
  "name": "@sornam-ai/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/main.ts",
    "worker:dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/workers/worker.ts",
    "seed:admin": "node dist/scripts/seed-admin.js",
    "seed:admin:dev": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/seed-admin.ts",
    "seed:ops": "node dist/scripts/seed-ops.js",
    "seed:ops:dev": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/seed-ops.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "test": "jest --runInBand",
    "test:e2e": "jest --runInBand --testRegex '.*\\.e2e-spec\\.ts$'",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.1.0",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.2",
    "decimal.js": "^10.4.3",
    "ioredis": "^5.4.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "ws": "^8.21.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
