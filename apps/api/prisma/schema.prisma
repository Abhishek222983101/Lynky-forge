generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  salesperson
  workshop_manager
  admin
}

enum StorageMode {
  shared_cloud
  private_cloud
  on_premise
}

enum AccessSection {
  home
  dashboard
  pipeline
  companies
  rfqs
  quotes
  tasks
  ask
  team
}

// --- Manufacturing CRM enums ---

enum DealStage {
  NEW_RFQ
  CONTACTED
  QUOTE_SENT
  NEGOTIATION
  WON
  LOST
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum TaskType {
  FOLLOW_UP
  CALL
  SEND_QUOTE
  RENEGOTIATE
  MEETING
}

enum TaskStatus {
  DUE
  DONE
  SKIPPED
}

enum ActivityType {
  NOTE
  STAGE_CHANGE
  QUOTE_SENT
  EMAIL
  CALL
  TASK_CREATED
  DEAL_WON
  DEAL_LOST
}

enum Industry {
  AUTOMOTIVE
  AEROSPACE
  ELECTRONICS
  MEDICAL
  INDUSTRIAL
}

enum LeadScore {
  HOT
  WARM
  COLD
}

enum DealSource {
  WEBSITE
  REFERRAL
  COLD_OUTREACH
  TRADE_SHOW
  RFQ_PORTAL
}

enum RfqSource {
  WEBSITE
  EMAIL
  PHONE
  WHATSAPP
  REFERRAL
}

enum OrderStatus {
  PENDING
  IN_PRODUCTION
  DELIVERED
  CANCELLED
}

// --- Kept models ---

model Shop {
  id              String              @id @default(uuid()) @db.Uuid
  name            String
  legalName       String?             @map("legal_name")
  gstNumber       String?             @map("gst_number")
  address         String?
  phone           String?
  defaultLanguage String              @default("en-IN") @map("default_language")
  storageMode     StorageMode         @default(shared_cloud) @map("storage_mode")
  currency        String              @default("INR")
  timezone        String              @default("Asia/Kolkata")
  isActive        Boolean             @default(true) @map("is_active")
  socialConfig    Json?               @map("social_config")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  users           User[]
  companies       Company[]
  contacts        Contact[]
  deals           Deal[]
  rfqs            Rfq[]
  quotes          Quote[]
  tasks           Task[]
  activities      Activity[]
  orders          Order[]
  accessRules     UserSectionAccess[]

  @@map("shops")
}

model User {
  id           String              @id @default(uuid()) @db.Uuid
  shopId       String?             @map("shop_id") @db.Uuid
  fullName     String              @map("full_name")
  phone        String?
  email        String?             @unique
  passwordHash String              @map("password_hash")
  role         UserRole
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  shop         Shop?               @relation(fields: [shopId], references: [id])
  accessRules  UserSectionAccess[]

  @@index([shopId])
  @@map("users")
}

model UserSectionAccess {
  id        String        @id @default(uuid()) @db.Uuid
  shopId    String        @map("shop_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  section   AccessSection
  canAccess Boolean       @default(true) @map("can_access")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  shop      Shop          @relation(fields: [shopId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@unique([userId, section])
  @@index([shopId])
  @@index([shopId, section])
  @@map("user_section_access")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String?  @map("shop_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  source      String
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([shopId])
  @@index([actorUserId])
  @@map("audit_logs")
}

model InternalEvent {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  eventName String   @map("event_name")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([shopId])
  @@index([eventName])
  @@map("internal_events")
}

// --- Manufacturing CRM models ---

model Company {
  id              String      @id @default(uuid()) @db.Uuid
  shopId          String      @map("shop_id") @db.Uuid
  name            String
  industry        Industry
  city            String?
  size            String?
  website         String?
  annualPotential Decimal?    @map("annual_potential") @db.Decimal(14, 2)
  source          DealSource?
  tags            Json?
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  shop            Shop        @relation(fields: [shopId], references: [id])
  contacts        Contact[]
  deals           Deal[]
  rfqs            Rfq[]
  tasks           Task[]
  activities      Activity[]

  @@index([shopId])
  @@index([shopId, industry])
  @@map("companies")
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  role      String?
  phone     String?
  email     String?
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shop      Shop     @relation(fields: [shopId], references: [id])
  company   Company  @relation(fields: [companyId], references: [id])
  deals     Deal[]

  @@index([shopId])
  @@index([companyId])
  @@map("contacts")
}

model Deal {
  id              String      @id @default(uuid()) @db.Uuid
  shopId          String      @map("shop_id") @db.Uuid
  title           String
  companyId       String      @map("company_id") @db.Uuid
  contactId       String?     @map("contact_id") @db.Uuid
  ownerId         String?     @map("owner_id") @db.Uuid
  value           Decimal     @db.Decimal(14, 2)
  stage           DealStage   @default(NEW_RFQ)
  expectedClose   DateTime?   @map("expected_close") @db.Date
  lostReason      String?     @map("lost_reason")
  source          DealSource?
  leadScore       LeadScore   @default(WARM) @map("lead_score")
  leadScoreReason Json?       @map("lead_score_reason")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  shop            Shop        @relation(fields: [shopId], references: [id])
  company         Company     @relation(fields: [companyId], references: [id])
  contact         Contact?    @relation(fields: [contactId], references: [id])
  rfq             Rfq?
  quote           Quote?
  tasks           Task[]
  activities      Activity[]
  order           Order?

  @@index([shopId])
  @@index([shopId, stage])
  @@index([shopId, leadScore])
  @@index([shopId, expectedClose])
  @@index([shopId, companyId])
  @@map("deals")
}

model Rfq {
  id           String    @id @default(uuid()) @db.Uuid
  shopId       String    @map("shop_id") @db.Uuid
  dealId       String    @unique @map("deal_id") @db.Uuid
  partName     String    @map("part_name")
  partNo       String    @map("part_no")
  material     String
  qty          Int
  tolerance    String?
  targetPrice  Decimal?  @map("target_price") @db.Decimal(14, 2)
  deadline     DateTime  @db.Date
  drawingNotes String?   @map("drawing_notes")
  source       RfqSource
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  shop         Shop      @relation(fields: [shopId], references: [id])
  deal         Deal      @relation(fields: [dealId], references: [id])
  company      Company?  @relation(fields: [companyId], references: [id])
  companyId    String?   @db.Uuid

  @@index([shopId])
  @@index([dealId])
  @@map("rfqs")
}

model Quote {
  id          String      @id @default(uuid()) @db.Uuid
  shopId      String      @map("shop_id") @db.Uuid
  dealId      String      @unique @map("deal_id") @db.Uuid
  quoteNo     String      @map("quote_no")
  status      QuoteStatus @default(DRAFT)
  totalAmount Decimal     @map("total_amount") @db.Decimal(14, 2)
  validUntil  DateTime    @map("valid_until") @db.Date
  aiGenerated Boolean     @default(false) @map("ai_generated")
  lineItems   Json        @map("line_items")
  terms       Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  shop        Shop        @relation(fields: [shopId], references: [id])
  deal        Deal        @relation(fields: [dealId], references: [id])

  @@unique([shopId, quoteNo])
  @@index([shopId])
  @@index([dealId])
  @@map("quotes")
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  shopId      String     @map("shop_id") @db.Uuid
  dealId      String?    @map("deal_id") @db.Uuid
  companyId   String?    @map("company_id") @db.Uuid
  type        TaskType
  status      TaskStatus @default(DUE)
  dueAt       DateTime   @map("due_at")
  message     String?
  autoCreated Boolean    @default(false) @map("auto_created")
  createdBy   String?    @map("created_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  shop        Shop       @relation(fields: [shopId], references: [id])
  deal        Deal?      @relation(fields: [dealId], references: [id])
  company     Company?   @relation(fields: [companyId], references: [id])

  @@index([shopId])
  @@index([shopId, status, dueAt])
  @@index([dealId])
  @@index([companyId])
  @@map("tasks")
}

model Activity {
  id          String       @id @default(uuid()) @db.Uuid
  shopId      String       @map("shop_id") @db.Uuid
  dealId      String?      @map("deal_id") @db.Uuid
  companyId   String?      @map("company_id") @db.Uuid
  type        ActivityType
  description String
  metadata    Json?
  actorId     String?      @map("actor_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  shop        Shop         @relation(fields: [shopId], references: [id])
  deal        Deal?        @relation(fields: [dealId], references: [id])
  company     Company?     @relation(fields: [companyId], references: [id])

  @@index([shopId])
  @@index([dealId, createdAt])
  @@index([companyId, createdAt])
  @@map("activities")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  shopId      String      @map("shop_id") @db.Uuid
  dealId      String      @unique @map("deal_id") @db.Uuid
  orderNo     String      @map("order_no")
  totalAmount Decimal     @map("total_amount") @db.Decimal(14, 2)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  shop        Shop        @relation(fields: [shopId], references: [id])
  deal        Deal        @relation(fields: [dealId], references: [id])

  @@unique([shopId, orderNo])
  @@index([shopId])
  @@index([dealId])
  @@map("orders")
}

model AiQuoteCache {
  id        String   @id @default(uuid()) @db.Uuid
  rfqHash   String   @unique @map("rfq_hash")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_quote_cache")
}

model AskCache {
  id           String   @id @default(uuid()) @db.Uuid
  questionHash String   @unique @map("question_hash")
  answer       String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("ask_cache")
}

model DashboardSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  date          DateTime @unique @db.Date
  pipelineValue Decimal  @map("pipeline_value") @db.Decimal(14, 2)
  dealsOpen     Int      @map("deals_open")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("dashboard_snapshots")
}
