generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StorageMode {
  shared_cloud
  private_cloud
  on_premise
}

enum UserRole {
  owner
  salesperson
  workshop_manager
  admin
}

enum InventoryStatus {
  available
  sold
  reserved
  in_workshop
  inactive
}

enum StockMovementType {
  stock_in
  stock_out
  sale
  reserve
  unreserve
  workshop_issue
  workshop_receive
  adjustment
  return
}

enum KarigarJobStatus {
  open
  partially_returned
  returned
  cancelled
}

enum ContentRequestStatus {
  requested
  processing
  ready
  failed
  cancelled
}

enum ContentAssetType {
  still
  reel
  caption
}

enum CustomerType {
  retail
  wholesale
}

enum FollowUpType {
  thank_you
  festival
  anniversary
  win_back
  scheme_due
  repair_ready
  manual
}

enum FollowUpStatus {
  due
  scheduled
  sent
  skipped
}

enum SavingsSchemeStatus {
  active
  matured
  closed
  cancelled
}

enum RepairOrderStatus {
  received
  in_workshop
  ready
  delivered
  cancelled
}

enum ScanBillStatus {
  received
  extracted
  awaiting_confirmation
  converted
  failed
  cancelled
}

enum BuybackItemStatus {
  recorded
  bundled
  flagged
  settled
}

enum AuditBookStatus {
  included
  excluded
}

enum AccessSection {
  home
  owner_cockpit
  customers
  invoices
  inventory
  workshop
  content
  audit_books
  team
  buyback
  schemes
  repairs
}

enum AccountingProvider {
  tally
  vyapar
  busy
  zoho_books
}

enum AccountingExportType {
  sales_invoices
  payments
  customers
  inventory_items
  audit_books
}

enum AccountingExportStatus {
  pending
  generated
  failed
}

enum PaymentStatus {
  paid
  partial
  pending
}

enum Source {
  manual
  voice_app
  whatsapp_voice
}

enum ConfirmationStatus {
  confirmed
  cancelled
}

enum MakingChargeType {
  percentage
  fixed
}

enum PaymentMethod {
  cash
  upi
  card
  bank_transfer
  other
}

enum PendingPaymentStatus {
  open
  partially_paid
  closed
  written_off
}

enum EInvoiceStatus {
  not_required
  pending
  pending_generation
  generated
  failed
}

enum VoiceSource {
  app_speak
  whatsapp_voice
}

enum VoiceIntent {
  record_sale
  ask_owner_question
  record_payment
  unknown
}

enum VoiceStatus {
  received
  parsed
  awaiting_clarification
  awaiting_confirmation
  confirmed
  executed
  cancelled
  failed
}

enum VoiceToolInvocationStatus {
  proposed
  awaiting_confirmation
  confirmed
  executed
  cancelled
  failed
}

model Shop {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  legalName       String?         @map("legal_name")
  gstNumber       String?         @map("gst_number")
  address         String?
  phone           String?
  defaultLanguage String          @default("ta-IN") @map("default_language")
  storageMode     StorageMode     @default(shared_cloud) @map("storage_mode")
  currency        String          @default("INR")
  timezone        String          @default("Asia/Kolkata")
  isActive        Boolean         @default(true) @map("is_active")
  // Social publishing config (Buffer token + connected profiles). JSON so no
  // schema churn as fields evolve; never returned raw to the client.
  socialConfig    Json?           @map("social_config")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  users           User[]
  customers       Customer[]
  inventoryItems  InventoryItem[]
  sales           Sale[]
  saleCounter     SaleCounter?
  stockMovements  StockMovement[]
  karigars        Karigar[]
  contentRequests ContentRequest[]
  followUps       CustomerFollowUp[]
  savingsSchemes  SavingsScheme[]
  schemePayments  SchemeInstallment[]
  repairOrders    RepairOrder[]
  distributorOrders DistributorOrder[]
  scanBillJobs    ScanBillJob[]
  buybackItems    BuybackItem[]
  buybackBundles  BuybackBundle[]
  auditBookEntries AuditBookEntry[]
  accessRules     UserSectionAccess[]
  metalRates      MetalRate[]
  accountingExports AccountingExport[]

  @@map("shops")
}

model SaleCounter {
  id                String   @id @default(uuid()) @db.Uuid
  shopId            String   @unique @map("shop_id") @db.Uuid
  nextSaleNumber    Int      @default(1) @map("next_sale_number")
  nextInvoiceNumber Int      @default(1) @map("next_invoice_number")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  shop              Shop     @relation(fields: [shopId], references: [id])

  @@map("sale_counters")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  shopId       String?   @map("shop_id") @db.Uuid
  fullName     String    @map("full_name")
  phone        String?
  email        String?   @unique
  passwordHash String    @map("password_hash")
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  shop         Shop?     @relation(fields: [shopId], references: [id])
  accessRules  UserSectionAccess[]

  @@index([shopId])
  @@map("users")
}

model Customer {
  id                String   @id @default(uuid()) @db.Uuid
  shopId            String   @map("shop_id") @db.Uuid
  fullName          String   @map("full_name")
  phone             String?
  customerType      CustomerType @default(retail) @map("customer_type")
  companyName       String?  @map("company_name")
  preferredLanguage String?  @map("preferred_language")
  birthday          DateTime? @db.Date
  anniversaryDate   DateTime? @map("anniversary_date") @db.Date
  tags              Json?
  preferences       Json?
  messageOptIn      Boolean  @default(false) @map("message_opt_in")
  consentAt         DateTime? @map("consent_at")
  importedAt        DateTime? @map("imported_at")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  shop              Shop     @relation(fields: [shopId], references: [id])
  sales             Sale[]
  followUps         CustomerFollowUp[]
  savingsSchemes    SavingsScheme[]
  repairOrders      RepairOrder[]
  distributorOrders DistributorOrder[]
  buybackItems      BuybackItem[]

  @@unique([shopId, phone])
  @@index([shopId])
  @@index([shopId, customerType])
  @@map("customers")
}

model CustomerFollowUp {
  id         String         @id @default(uuid()) @db.Uuid
  shopId     String         @map("shop_id") @db.Uuid
  customerId String         @map("customer_id") @db.Uuid
  type       FollowUpType
  status     FollowUpStatus @default(due)
  dueAt      DateTime       @map("due_at")
  message    String?
  metadata   Json?
  createdBy  String?        @map("created_by") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  shop       Shop           @relation(fields: [shopId], references: [id])
  customer   Customer       @relation(fields: [customerId], references: [id])

  @@index([shopId])
  @@index([shopId, status, dueAt])
  @@index([customerId])
  @@map("customer_follow_ups")
}

model SavingsScheme {
  id             String              @id @default(uuid()) @db.Uuid
  shopId         String              @map("shop_id") @db.Uuid
  customerId     String              @map("customer_id") @db.Uuid
  schemeNumber   String              @map("scheme_number")
  monthlyAmount  Decimal             @map("monthly_amount") @db.Decimal(14, 2)
  months         Int
  startDate      DateTime            @map("start_date") @db.Date
  maturityDate   DateTime            @map("maturity_date") @db.Date
  status         SavingsSchemeStatus @default(active)
  notes          String?
  createdBy      String              @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  shop           Shop                @relation(fields: [shopId], references: [id])
  customer       Customer            @relation(fields: [customerId], references: [id])
  installments   SchemeInstallment[]

  @@unique([shopId, schemeNumber])
  @@index([shopId])
  @@index([shopId, customerId])
  @@index([shopId, status])
  @@map("savings_schemes")
}

model SchemeInstallment {
  id              String        @id @default(uuid()) @db.Uuid
  shopId          String        @map("shop_id") @db.Uuid
  schemeId        String        @map("scheme_id") @db.Uuid
  amount          Decimal       @db.Decimal(14, 2)
  paidAt          DateTime      @map("paid_at")
  paymentMethod   PaymentMethod @map("payment_method")
  referenceNumber String?       @map("reference_number")
  createdBy       String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  shop            Shop          @relation(fields: [shopId], references: [id])
  scheme          SavingsScheme @relation(fields: [schemeId], references: [id])

  @@index([shopId])
  @@index([schemeId])
  @@map("scheme_installments")
}

model RepairOrder {
  id              String             @id @default(uuid()) @db.Uuid
  shopId          String             @map("shop_id") @db.Uuid
  customerId      String             @map("customer_id") @db.Uuid
  orderNumber     String             @map("order_number")
  itemDescription String             @map("item_description")
  purity          String?
  expectedDate    DateTime?          @map("expected_date") @db.Date
  status          RepairOrderStatus  @default(received)
  notes           String?
  createdBy       String             @map("created_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  shop            Shop               @relation(fields: [shopId], references: [id])
  customer        Customer           @relation(fields: [customerId], references: [id])
  statusEvents    RepairStatusEvent[]

  @@unique([shopId, orderNumber])
  @@index([shopId])
  @@index([shopId, customerId])
  @@index([shopId, status])
  @@map("repair_orders")
}

model RepairStatusEvent {
  id            String            @id @default(uuid()) @db.Uuid
  shopId        String            @map("shop_id") @db.Uuid
  repairOrderId String            @map("repair_order_id") @db.Uuid
  status        RepairOrderStatus
  notes         String?
  createdBy     String            @map("created_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")
  repairOrder   RepairOrder       @relation(fields: [repairOrderId], references: [id])

  @@index([shopId])
  @@index([repairOrderId])
  @@map("repair_status_events")
}

model DistributorOrder {
  id             String        @id @default(uuid()) @db.Uuid
  shopId         String        @map("shop_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  orderNumber    String        @map("order_number")
  metal          String
  ornamentType   String        @map("ornament_type")
  quantityWeight Decimal       @map("quantity_weight") @db.Decimal(12, 3)
  orderValue     Decimal       @map("order_value") @db.Decimal(14, 2)
  paymentStatus  PaymentStatus @default(pending) @map("payment_status")
  notes          String?
  createdBy      String        @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  shop           Shop          @relation(fields: [shopId], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id])

  @@unique([shopId, orderNumber])
  @@index([shopId])
  @@index([shopId, customerId])
  @@map("distributor_orders")
}

model InventoryItem {
  id          String          @id @default(uuid()) @db.Uuid
  shopId      String          @map("shop_id") @db.Uuid
  sku         String?
  name        String
  category    String?
  purity      String
  huidNumber  String?         @map("huid_number")
  grossWeight Decimal?        @map("gross_weight") @db.Decimal(12, 3)
  netWeight   Decimal?        @map("net_weight") @db.Decimal(12, 3)
  estimatedValue Decimal?     @map("estimated_value") @db.Decimal(14, 2)
  acquisitionDate DateTime?   @map("acquisition_date") @db.Date
  location    String?
  photoUrl    String?         @map("photo_url")
  status      InventoryStatus @default(available)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  shop        Shop            @relation(fields: [shopId], references: [id])
  saleItems   SaleItem[]
  movements   StockMovement[]
  karigarJobs KarigarJob[]
  contentRequests ContentRequest[]

  @@index([shopId])
  @@index([shopId, status])
  @@map("inventory_items")
}

model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  shopId          String            @map("shop_id") @db.Uuid
  inventoryItemId String?           @map("inventory_item_id") @db.Uuid
  movementType    StockMovementType @map("movement_type")
  quantity        Int               @default(1)
  weight          Decimal?          @db.Decimal(12, 3)
  fromStatus      InventoryStatus?  @map("from_status")
  toStatus        InventoryStatus?  @map("to_status")
  referenceType   String?           @map("reference_type")
  referenceId     String?           @map("reference_id") @db.Uuid
  notes           String?
  createdBy       String?           @map("created_by") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  shop            Shop              @relation(fields: [shopId], references: [id])
  inventoryItem   InventoryItem?    @relation(fields: [inventoryItemId], references: [id])

  @@index([shopId])
  @@index([shopId, inventoryItemId])
  @@index([shopId, movementType])
  @@map("stock_movements")
}

model Karigar {
  id             String       @id @default(uuid()) @db.Uuid
  shopId         String       @map("shop_id") @db.Uuid
  name           String
  phone          String?
  specialization String?
  notes          String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  shop           Shop         @relation(fields: [shopId], references: [id])
  jobs           KarigarJob[]

  @@index([shopId])
  @@map("karigars")
}

model KarigarJob {
  id               String           @id @default(uuid()) @db.Uuid
  shopId           String           @map("shop_id") @db.Uuid
  karigarId        String           @map("karigar_id") @db.Uuid
  inventoryItemId  String?          @map("inventory_item_id") @db.Uuid
  jobNumber        String?          @map("job_number")
  itemDescription  String           @map("item_description")
  purity           String
  issuedWeight     Decimal          @map("issued_weight") @db.Decimal(12, 3)
  issuedDate       DateTime         @default(now()) @map("issued_date") @db.Date
  dueDate          DateTime?        @map("due_date") @db.Date
  status           KarigarJobStatus @default(open)
  createdBy        String           @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  karigar          Karigar          @relation(fields: [karigarId], references: [id])
  inventoryItem    InventoryItem?   @relation(fields: [inventoryItemId], references: [id])
  returns          KarigarReturn[]

  @@unique([shopId, jobNumber])
  @@index([shopId])
  @@index([shopId, karigarId])
  @@map("karigar_jobs")
}

model KarigarReturn {
  id             String     @id @default(uuid()) @db.Uuid
  shopId         String     @map("shop_id") @db.Uuid
  karigarJobId   String     @map("karigar_job_id") @db.Uuid
  finishedWeight Decimal    @map("finished_weight") @db.Decimal(12, 3)
  scrapWeight    Decimal    @default(0) @map("scrap_weight") @db.Decimal(12, 3)
  wastageWeight  Decimal    @map("wastage_weight") @db.Decimal(12, 3)
  wastagePercent Decimal    @map("wastage_percent") @db.Decimal(8, 3)
  flagged        Boolean    @default(false)
  returnDate     DateTime   @default(now()) @map("return_date") @db.Date
  notes          String?
  createdBy      String     @map("created_by") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  job            KarigarJob @relation(fields: [karigarJobId], references: [id])

  @@index([shopId])
  @@index([shopId, karigarJobId])
  @@map("karigar_returns")
}

model ContentRequest {
  id              String               @id @default(uuid()) @db.Uuid
  shopId          String               @map("shop_id") @db.Uuid
  inventoryItemId String?              @map("inventory_item_id") @db.Uuid
  occasion        String?
  requestedBy     String               @map("requested_by") @db.Uuid
  status          ContentRequestStatus @default(requested)
  prompt          String?
  failureReason   String?              @map("failure_reason")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  shop            Shop                 @relation(fields: [shopId], references: [id])
  inventoryItem   InventoryItem?       @relation(fields: [inventoryItemId], references: [id])
  assets          ContentAsset[]

  @@index([shopId])
  @@index([shopId, inventoryItemId])
  @@map("content_requests")
}

model ContentAsset {
  id               String           @id @default(uuid()) @db.Uuid
  shopId           String           @map("shop_id") @db.Uuid
  contentRequestId String           @map("content_request_id") @db.Uuid
  assetType        ContentAssetType @map("asset_type")
  url              String?
  caption          String?
  aiLabel          String?          @map("ai_label")
  metadata         Json?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  request          ContentRequest   @relation(fields: [contentRequestId], references: [id])

  @@index([shopId])
  @@index([contentRequestId])
  @@map("content_assets")
}

model Sale {
  id                       String             @id @default(uuid()) @db.Uuid
  shopId                   String             @map("shop_id") @db.Uuid
  customerId               String?            @map("customer_id") @db.Uuid
  saleNumber               String             @map("sale_number")
  saleDate                 DateTime           @map("sale_date") @db.Date
  subtotalAmount           Decimal            @map("subtotal_amount") @db.Decimal(14, 2)
  makingChargeAmount       Decimal            @map("making_charge_amount") @db.Decimal(14, 2)
  hallmarkingChargeAmount  Decimal            @map("hallmarking_charge_amount") @db.Decimal(14, 2)
  gstAmount                Decimal            @map("gst_amount") @db.Decimal(14, 2)
  totalAmount              Decimal            @map("total_amount") @db.Decimal(14, 2)
  amountPaid               Decimal            @map("amount_paid") @db.Decimal(14, 2)
  pendingAmount            Decimal            @map("pending_amount") @db.Decimal(14, 2)
  paymentStatus            PaymentStatus      @map("payment_status")
  source                   Source
  confirmationStatus       ConfirmationStatus @default(confirmed) @map("confirmation_status")
  confirmedBy              String             @map("confirmed_by") @db.Uuid
  confirmedAt              DateTime           @map("confirmed_at")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")
  shop                     Shop               @relation(fields: [shopId], references: [id])
  customer                 Customer?          @relation(fields: [customerId], references: [id])
  items                    SaleItem[]
  payments                 Payment[]
  pendingPayment           PendingPayment?
  invoice                  Invoice?
  auditBookEntry           AuditBookEntry?

  @@unique([shopId, saleNumber])
  @@index([shopId])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id                       String           @id @default(uuid()) @db.Uuid
  shopId                   String           @map("shop_id") @db.Uuid
  saleId                   String           @map("sale_id") @db.Uuid
  inventoryItemId          String?          @map("inventory_item_id") @db.Uuid
  itemName                 String           @map("item_name")
  purity                   String
  grossWeight              Decimal          @map("gross_weight") @db.Decimal(12, 3)
  netWeight                Decimal          @map("net_weight") @db.Decimal(12, 3)
  goldRatePerGram          Decimal          @map("gold_rate_per_gram") @db.Decimal(14, 2)
  makingChargeType         MakingChargeType @map("making_charge_type")
  makingChargeValue        Decimal          @map("making_charge_value") @db.Decimal(12, 2)
  makingChargeAmount       Decimal          @map("making_charge_amount") @db.Decimal(14, 2)
  hallmarkingChargeAmount  Decimal          @default(0) @map("hallmarking_charge_amount") @db.Decimal(14, 2)
  lineSubtotal             Decimal          @map("line_subtotal") @db.Decimal(14, 2)
  gstAmount                Decimal          @map("gst_amount") @db.Decimal(14, 2)
  lineTotal                Decimal          @map("line_total") @db.Decimal(14, 2)
  huidNumber               String?          @map("huid_number")
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  sale                     Sale             @relation(fields: [saleId], references: [id])
  inventoryItem            InventoryItem?   @relation(fields: [inventoryItemId], references: [id])

  @@index([shopId])
  @@index([saleId])
  @@map("sale_items")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  shopId          String        @map("shop_id") @db.Uuid
  saleId          String?       @map("sale_id") @db.Uuid
  customerId      String?       @map("customer_id") @db.Uuid
  amount          Decimal       @db.Decimal(14, 2)
  paymentMethod   PaymentMethod @map("payment_method")
  paymentDate     DateTime      @map("payment_date") @db.Date
  referenceNumber String?       @map("reference_number")
  notes           String?
  createdBy       String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  sale            Sale?         @relation(fields: [saleId], references: [id])

  @@index([shopId])
  @@index([saleId])
  @@index([customerId])
  @@map("payments")
}

model PendingPayment {
  id         String               @id @default(uuid()) @db.Uuid
  shopId     String               @map("shop_id") @db.Uuid
  saleId     String               @unique @map("sale_id") @db.Uuid
  customerId String?              @map("customer_id") @db.Uuid
  amount     Decimal              @db.Decimal(14, 2)
  dueDate    DateTime?            @map("due_date") @db.Date
  status     PendingPaymentStatus @default(open)
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  sale       Sale                 @relation(fields: [saleId], references: [id])

  @@index([shopId])
  @@index([customerId])
  @@map("pending_payments")
}

model Invoice {
  id             String         @id @default(uuid()) @db.Uuid
  shopId         String         @map("shop_id") @db.Uuid
  saleId         String         @unique @map("sale_id") @db.Uuid
  invoiceNumber  String         @map("invoice_number")
  gstNumber      String?        @map("gst_number")
  taxableAmount  Decimal        @map("taxable_amount") @db.Decimal(14, 2)
  gstAmount      Decimal        @map("gst_amount") @db.Decimal(14, 2)
  totalAmount    Decimal        @map("total_amount") @db.Decimal(14, 2)
  pdfUrl         String?        @map("pdf_url")
  eInvoiceStatus EInvoiceStatus @default(pending_generation) @map("e_invoice_status")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  sale           Sale           @relation(fields: [saleId], references: [id])
  auditBookEntry AuditBookEntry?

  @@unique([shopId, invoiceNumber])
  @@index([shopId])
  @@map("invoices")
}

model ScanBillJob {
  id               String         @id @default(uuid()) @db.Uuid
  shopId           String         @map("shop_id") @db.Uuid
  status           ScanBillStatus @default(received)
  sourceFileUrl    String?        @map("source_file_url")
  rawText          String?        @map("raw_text")
  extractedPayload Json?          @map("extracted_payload")
  createdCustomerId String?       @map("created_customer_id") @db.Uuid
  createdSaleId    String?        @map("created_sale_id") @db.Uuid
  createdInvoiceId String?        @map("created_invoice_id") @db.Uuid
  failureReason    String?        @map("failure_reason")
  createdBy        String         @map("created_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  shop             Shop           @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([shopId, status])
  @@map("scan_bill_jobs")
}

model BuybackBundle {
  id           String        @id @default(uuid()) @db.Uuid
  shopId       String        @map("shop_id") @db.Uuid
  bundleNumber String        @map("bundle_number")
  metal        String
  purity       String
  ratePerGram  Decimal       @map("rate_per_gram") @db.Decimal(14, 2)
  totalWeight  Decimal       @default(0) @map("total_weight") @db.Decimal(12, 3)
  totalValue   Decimal       @default(0) @map("total_value") @db.Decimal(14, 2)
  status       String        @default("open")
  createdBy    String        @map("created_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  shop         Shop          @relation(fields: [shopId], references: [id])
  items        BuybackItem[]

  @@unique([shopId, bundleNumber])
  @@index([shopId])
  @@map("buyback_bundles")
}

model BuybackItem {
  id             String            @id @default(uuid()) @db.Uuid
  shopId         String            @map("shop_id") @db.Uuid
  bundleId       String?           @map("bundle_id") @db.Uuid
  customerId     String?           @map("customer_id") @db.Uuid
  itemName       String            @map("item_name")
  testedPurity   String            @map("tested_purity")
  assignedPurity String?           @map("assigned_purity")
  weight         Decimal           @db.Decimal(12, 3)
  ratePerGram    Decimal           @map("rate_per_gram") @db.Decimal(14, 2)
  calculatedValue Decimal          @map("calculated_value") @db.Decimal(14, 2)
  expectedValue  Decimal?          @map("expected_value") @db.Decimal(14, 2)
  mismatchAmount Decimal?          @map("mismatch_amount") @db.Decimal(14, 2)
  status         BuybackItemStatus @default(recorded)
  testingFormUrl String?           @map("testing_form_url")
  notes          String?
  createdBy      String            @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  shop           Shop              @relation(fields: [shopId], references: [id])
  bundle         BuybackBundle?    @relation(fields: [bundleId], references: [id])
  customer       Customer?         @relation(fields: [customerId], references: [id])

  @@index([shopId])
  @@index([shopId, bundleId])
  @@index([shopId, customerId])
  @@index([shopId, status])
  @@map("buyback_items")
}

model AuditBookEntry {
