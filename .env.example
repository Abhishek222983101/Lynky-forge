DATABASE_URL=postgresql://sornam:sornam@postgres:5432/sornam?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
GOLD_RATE_PROVIDER=
GOLD_RATE_API_KEY=
GOLD_RATE_STATIC_22K=
GOLD_RATE_STATIC_24K=
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_STT_LANGUAGE_CODE=unknown
SARVAM_CHAT_MODEL=sarvam-30b
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
SARVAM_TTS_LANGUAGE_CODE=en-IN
VOICE_INTENT_PROVIDER=sarvam
APP_ENV=local
PORT=3000
CORS_ORIGINS=*
FILE_STORAGE_PATH=/app/storage
SEED_ADMIN_EMAIL=admin@sornam.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Sornam Platform Admin
SEED_ADMIN_PHONE=

# --- Google / Gemini (one key, used by Live voice and Content Studio) ---
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview

# --- M4 Content Studio (Amaan) ---
# All optional. With everything unset it runs on safe stubs (demo works, no cost).
# To go live, set the provider switches to the real engines AND provide the keys.
CONTENT_ORCHESTRATOR_PROVIDER=deterministic   # deterministic | sarvam
CONTENT_IMAGE_PROVIDER=stub                    # stub | gemini
CONTENT_VIDEO_PROVIDER=stub                    # stub | veo3
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
VEO_API_KEY=
VEO_MODEL=veo-3.0-generate-preview
CONTENT_ASSET_BASE_URL=https://assets.sornam.local/content

# Demo seed for Amaan's modules (npm run seed:ops:dev)
SEED_SHOP_NAME=Sornam Demo Jewellers
SEED_OWNER_EMAIL=owner@demo.sornam
SEED_OWNER_PASSWORD=DemoOwnerPass123
