# Lynky Forge — API Environment
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
APP_ENV=local
PORT=3000
CORS_ORIGINS=*
NEXT_PUBLIC_API_URL=http://localhost:3001

# Groq AI (primary — free, fast, Llama 3.3 70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Kimi AI (optional fallback)
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Vercel Cron (set before Phase 7)
CRON_SECRET=

# Seed config
SEED_ADMIN_EMAIL=admin@forge.demo
SEED_ADMIN_PASSWORD=DemoPass12345!
SEED_ADMIN_FULL_NAME=Forge Admin
SEED_ADMIN_PHONE=+91-99999-00000
